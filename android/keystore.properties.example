# Copy to keystore.properties and fill in after creating your upload keystore.
# Generate keystore (one time):
#   keytool -genkey -v -keystore neik-amal-upload.keystore -alias neik-amal -keyalg RSA -keysize 2048 -validity 10000
storeFile=../neik-amal-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=neik-amal
keyPassword=YOUR_KEY_PASSWORD
