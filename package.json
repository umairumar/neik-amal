{
  "name": "neik-amal",
  "version": "1.0.0",
  "description": "Neik-Amal — Pious deeds tracker (نیک عمل)",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/sync-www.mjs",
    "build": "npm run prebuild",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "assets:generate": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.8.3"
  }
}
